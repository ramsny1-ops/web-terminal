{
  "name": "rtx-webterminal",
  "version": "1.0.0",
  "description": "Remote web terminal — Bun runtime + TypeScript + native PTY + offline xterm.js",
  "type": "module",
  "scripts": {
    "dev": "bun run src/server.ts",
    "start": "bun run src/server.ts",
    "build:client": "bun build src/client.ts --outdir public --target browser --minify",
    "build": "bun run build:client"
  },
  "dependencies": {
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0"
  }
}
